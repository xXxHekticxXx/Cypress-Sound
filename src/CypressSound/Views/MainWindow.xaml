<Window x:Class="CypressSound.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cypress Sound" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Background="{DynamicResource Bg}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SideCol" Width="300" MinWidth="220" MaxWidth="640"/>
      <ColumnDefinition Width="6"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- left: outputs, microphones, auto profiles -->
    <Border Background="{DynamicResource Bg2}">
      <DockPanel Margin="16,14,12,12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,4">
          <TextBlock Text="Cypress Sound" FontSize="20" FontWeight="SemiBold"/>
        </StackPanel>
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <Button x:Name="SettingsBtn" Content="⚙  Settings" HorizontalAlignment="Left" Margin="0"/>
          <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Style="{StaticResource Head}" Text="OUTPUTS  ·  click to switch"/>
            <StackPanel x:Name="OutputList"/>
            <TextBlock Style="{StaticResource Head}" Text="MICROPHONES"/>
            <StackPanel x:Name="InputList"/>
            <TextBlock Style="{StaticResource Head}" Text="AUTO PROFILES"/>
            <StackPanel x:Name="ProfileList"/>
            <Button x:Name="AddProfileBtn" Content="+  New profile" HorizontalAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- drag this edge to make the list wider or narrower -->
    <GridSplitter x:Name="SideSplit" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE" ToolTip="Drag to resize"/>

    <!-- right: EQ for the selected device -->
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="RightPanel" Margin="24,16,24,24">
        <StackPanel x:Name="Banners"/>
        <Grid Margin="0,4,0,8">
          <StackPanel>
            <TextBlock x:Name="DeviceTitle" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="DeviceSub" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
          </StackPanel>
          <CheckBox x:Name="EqPower" Style="{StaticResource Switch}" Content="EQ" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="15"/>
        </Grid>

        <WrapPanel x:Name="ModeTabs" Margin="0,6,0,4"/>
        <WrapPanel x:Name="PresetChips" Margin="0,4,0,0"/>

        <Border Background="{DynamicResource Panel}" CornerRadius="14" Padding="16" Margin="0,6,0,0">
          <StackPanel>
            <Canvas x:Name="Curve" Height="110" ClipToBounds="True" Margin="0,0,0,10"/>
            <ContentControl x:Name="EqBody"/>
          </StackPanel>
        </Border>

        <StackPanel x:Name="SoundBarHost" Margin="0,12,0,0"/>
        <UniformGrid x:Name="Cards" Columns="3" Margin="0,0,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
